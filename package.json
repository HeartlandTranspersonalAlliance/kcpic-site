    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "prettier-plugin-astro": "1.0.1",
