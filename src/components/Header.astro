---
import { href, nav } from '../data/site';
import Mark from './Mark.astro';
const active = Astro.url.pathname.replace(/\/$/, '');
---

<header class="site-header">
  <div class="site-container header-inner">
    <a
      class="brand"
      href={href()}
      aria-label="Kansas City Psychedelic Integration Circle home"
    >
      <Mark />
      <span>
        <strong>Kansas City</strong> <span>Psychedelic Integration Circle</span>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {nav.map((item) => (
        <a
          href={href(item.path)}
          aria-current={
            active === href(item.path).replace(/\/$/, '') ? 'page' : undefined
          }
        >
          {item.label}
        </a>
      ))}
    </nav>
    <details class="mobile-nav">
      <summary
        id="mobile-nav-toggle"
        role="button"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        Menu <span aria-hidden="true">＋</span>
      </summary>
      <nav id="mobile-navigation" aria-label="Mobile navigation">
        {nav.map((item) => (
          <a
            href={href(item.path)}
            aria-current={
              active === href(item.path).replace(/\/$/, '') ? 'page' : undefined
            }
          >
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const mobileNav = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  const mobileNavToggle =
    mobileNav?.querySelector<HTMLElement>('#mobile-nav-toggle');

  const syncMobileNavState = () => {
    mobileNavToggle?.setAttribute(
      'aria-expanded',
      String(mobileNav?.open ?? false),
    );
  };

  mobileNav?.addEventListener('toggle', syncMobileNavState);
  syncMobileNavState();
</script>
