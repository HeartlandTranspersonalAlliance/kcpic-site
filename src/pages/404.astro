---
import Layout from '../layouts/Layout.astro';
import { href } from '../data/site';
---
<Layout title="Page not found" noindex><section class="section"><div class="container"><p class="eyebrow">404 · Page not found</p><h1>Let's get you<br />back to the circle.</h1><p class="lead mt-6 mb-8">This page may have moved or the address may be incorrect.</p><a class="button" href={href()}>Return home <span aria-hidden="true">→</span></a></div></section></Layout>
