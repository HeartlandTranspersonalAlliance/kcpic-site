---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import mushrooms from '../assets/mushrooms.webp';
import community from '../assets/community.webp';
import { home } from '../data/content';
import { href, site } from '../data/site';
// Image sizes follow the container gutters, 850px stack breakpoint, and hero circle cap.
---

<Layout>
  <section class="hero">
    <div class="site-container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="small-ring" aria-hidden="true"></span> A monthly circle.
          A shared experience.
        </p>
        <h1>
          Kansas City
          <br />
          <em>Psychedelic</em>
          <br />
          Integration Circle
        </h1>
        <p class="hero-welcome">{home.welcome}</p>
        <p class="hero-description">{home.introduction}</p>
        <div class="flex flex-wrap gap-4 hero-actions">
          <a class="button" href={href('meetings/')}>
            Explore our meetings <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={href('about/')}>
            Who we are <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="hero-art">
        <div class="photo-orbit">
          <Image
            src={mushrooms}
            alt="Red-capped mushrooms growing together on a woodland floor"
            widths={[480, 800, 1200]}
            sizes="(max-width: 440px) calc(82vw - 26px), (max-width: 850px) min(470px, calc(82vw - 33px)), (max-width: 1100px) calc(46.5vw - 64px), (max-width: 1432px) calc(46.5vw - 86px), 580px"
            width={1200}
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="orbit-note">
          <span class="small-ring" aria-hidden="true"></span>
          <span>
            Room for your experience.
            <br />
            Space for connection.
          </span>
        </div>
      </div>
    </div>
  </section>
  <div class="values-strip">
    <div class="site-container">
      <span>All kinds of experiences</span>
      <span class="strip-circle" aria-hidden="true"></span>
      <span>A judgement-free space</span>
      <span class="strip-circle" aria-hidden="true"></span>
      <span>Community of peers</span>
    </div>
  </div>
  <section class="section">
    <div class="site-container introduction-grid">
      <div>
        <p class="eyebrow">Sharing &amp; understanding</p>
        <h2>What is Psychedelic Integration?</h2>
      </div>
      <div class="prose">
        <p class="lead">{home.invitation}</p>
        <p>{home.belief}</p>
        <a class="text-link" href={href('about/')}>
          Learn more <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
  <section class="connection-section">
    <div class="site-container connection-grid">
      <Image
        src={community}
        alt="A group of people placing their hands together in a circle"
        widths={[480, 800, 1100, 1500]}
        sizes="(max-width: 440px) calc(100vw - 32px), (max-width: 850px) calc(100vw - 40px), (max-width: 1100px) calc(50vw - 32px), (max-width: 1432px) calc(50vw - 56px), 660px"
        width={1100}
        format="webp"
        loading="lazy"
      />
      <div class="connection-copy">
        <p class="eyebrow">Stay connected</p>
        <h2>
          Connect with us
          <br />
          on Facebook
        </h2>
        <p>Find current meeting details and connect with our community.</p>
        <a class="button" href={site.facebook}>
          KCPIC on Facebook <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
